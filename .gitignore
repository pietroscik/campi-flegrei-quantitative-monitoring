```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
.Python

# Virtual environments
venv/
.venv/
env/
.ENV

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
build/
dist/
*.egg
*.egg-info/
.eggs/

# Testing
.coverage
coverage/
htmlcov/
.nyc_output/
.mypy_cache/
.pytest_cache/
.hypothesis/

# Logs
*.log
logs/

# Environment variables
.env
.env.local
.env.*
!.env.example

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Compressed files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
```